{
  "name": "investorAgent",
  "model": {
    "provider": "bedrock",
    "modelId": "us.anthropic.claude-sonnet-4-6"
  },
  "tools": [
    {
      "type": "agentcore_gateway",
      "name": "market-data",
      "config": {
        "agentCoreGateway": {
          "gatewayArn": "arn:aws:bedrock-agentcore:us-west-2:347272280436:gateway/crexiworkshopv2-gw-readonly-dev01-zbqpufxu0p",
          "outboundAuth": {
            "awsIam": {}
          }
        }
      }
    },
    {
      "type": "agentcore_code_interpreter",
      "name": "code-interpreter"
    },
    {
      "type": "inline_function",
      "name": "submit_underwriting_result",
      "config": {
        "inlineFunction": {
          "description": "Submit the underwriting comparison JSON exactly as printed by the code-interpreter tool's stdout on its last line. You MUST have called code-interpreter earlier in THIS turn before calling this -- the backend verifies this and will reject the call otherwise. Never construct this payload yourself; copy it verbatim from the code-interpreter tool result.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "comparison": {
                "type": "object",
                "description": "The exact JSON object code-interpreter printed (type, criteria, properties, recommended), parsed."
              }
            },
            "required": [
              "comparison"
            ]
          }
        }
      }
    }
  ],
  "skills": [],
  "allowedTools": [
    "@market-data/*",
    "@code-interpreter",
    "@submit_underwriting_result"
  ],
  "memory": {
    "mode": "managed",
    "strategies": [
      "SEMANTIC",
      "SUMMARIZATION",
      "USER_PREFERENCE"
    ],
    "eventExpiryDuration": 30
  }
}
