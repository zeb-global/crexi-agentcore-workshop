# Per-participant harness dirs generated by scripts/render_agentcore_config.py
# from the canonical app/investorAgent/ and app/brokerAgent/ sources -- the
# AgentCore CLI derives a harness's config directory from its registry name,
# not a separate path, so a uniquely-named harness needs its own directory.
app/investorAgent_*/
app/brokerAgent_*/
